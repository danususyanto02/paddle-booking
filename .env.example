# Kinetic Court — .env.example (production-secure placeholders, never real secrets)
# Copy to .env.local for local dev and fill with real values where noted.

# ── Database ──────────────────────────────────────────────────────────
# Local dev may use sslmode=disable; production MUST use sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/kinetic_court?sslmode=disable"

# ── Auth ──────────────────────────────────────────────────────────────
# Each must be >=32 chars and must be distinct (production fail-fast if equal)
AUTH_SECRET="replace-with-long-random-secret-at-least-32-chars-AAAA"
JWT_SECRET="replace-with-different-long-random-secret-at-least-32-BBBB"

# ── Super Admin (seed) ────────────────────────────────────────────────
SUPER_ADMIN_USERNAME="superadmin"
# In production this MUST NOT be superadmin/password/admin (fail-fast)
SUPER_ADMIN_PASSWORD="superadmin"

# ── Registration ─────────────────────────────────────────────────────
PUBLIC_REGISTRATION_ENABLED=false

# ── Rate Limit ───────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_SECONDS=60

# ── External API Demo (restful-api.dev) ───────────────────────────────
RESTFUL_API_DEV_BASE_URL="https://api.restful-api.dev"
RESTFUL_API_DEV_API_KEY="replace-with-provider-key"
RESTFUL_API_DEV_TIMEOUT_MS=5000

# ── Proxy ─────────────────────────────────────────────────────────────
TRUST_PROXY=false

# ── App ───────────────────────────────────────────────────────────────
# NEXTAUTH_URL is required by Auth.js in production
NEXTAUTH_URL="http://localhost:3000"
